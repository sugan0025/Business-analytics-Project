# Copy to .env for local use. On Vercel, set these under Project -> Settings -> Environment Variables.
# Never commit the real .env file.

# Long random string used to sign login cookies (python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=change-me

# Postgres connection string (Vercel Storage -> Neon adds DATABASE_URL / POSTGRES_URL for you).
# Leave empty locally to use a SQLite file (faculty.db).
DATABASE_URL=

# Google Sign-In: OAuth Web client ID (Google Cloud Console -> Credentials)
GOOGLE_CLIENT_ID=

# Google Sheet that receives responses
GOOGLE_SHEET_ID=1n6X-h_8SkutNImAgkLsbxogW5Qz8yD6-Z8SyhiNp2BI

# Service account key: paste the whole JSON on one line (Vercel) or point to the file (local)
GOOGLE_SERVICE_ACCOUNT_JSON=
# GOOGLE_SERVICE_ACCOUNT_FILE=credentials.json

# College email rule: <name>.mb25@<domain>
ALLOWED_EMAIL_DOMAIN=bitsathy.ac.in
EMAIL_LOCAL_SUFFIX=.mb25

# Timer and attempts
TIMER_SECONDS=60
MAX_ATTEMPTS=5

# Optional: form opens at this time (ISO, IST assumed if no offset), e.g. 2026-10-07T10:00:00+05:30
OPEN_AT=
# Set to 1 to close the form immediately
FORM_CLOSED=0

# Text on the form
FORM_TITLE=Faculty Selection - II MBA
FORM_DESCRIPTION=Select one faculty member. Seats are allotted strictly first come, first served. You have 60 seconds to submit once the form opens.

# Secret for POST /api/sync (manual retry of Sheet sync). Optional.
SYNC_TOKEN=

# Local testing only: lets you sign in without Google. Ignored on Vercel production.
DEV_LOGIN=0
